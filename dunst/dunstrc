[global]
    font = GeistMono Nerd Font 11
    width = 360
    height = (0, 260)
    origin = top-right
    offset = (12, 48)
    notification_limit = 4
    padding = 12
    horizontal_padding = 14
    frame_width = 1
    corner_radius = 8
    format = "<b>%s</b>\n%b"
    dmenu = /usr/bin/wmenu -f "GeistMono Nerd Font 11" -p "Notification action"
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    timeout = 4

[urgency_normal]
    timeout = 7

[urgency_critical]
    timeout = 0

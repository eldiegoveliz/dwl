#!/bin/sh
set -eu

exec </dev/null

dbus-update-activation-environment --systemd \
	WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE || true

swaybg \
	-i /home/diego/wallpapers/mountain-river-green-aesthetic-desktop-wallpaper.jpg \
	-m fill &

if ! pgrep -x dunst >/dev/null 2>&1; then
	dunst &
fi

if ! pgrep -f '/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1' >/dev/null 2>&1; then
	/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &
fi

thunar --daemon &

# dwl terminates this process group when the compositor exits.
wait

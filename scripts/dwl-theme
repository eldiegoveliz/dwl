#!/bin/sh
set -eu
case ${1:-} in dark|light) ;; *) exit 2 ;; esac
config=${DWL_CONFIG_DIR:-$HOME/.config/dwl}
# Run only while the dwl session's services are active.
systemctl --user is-active --quiet dwl-terminal.service || exit 0
"$config/scripts/dwl-render-theme" "$1"
makoctl reload
case "$1" in dark) signal=USR1 ;; light) signal=USR2 ;; esac
systemctl --user kill --signal="$signal" --kill-whom=main dwl-terminal.service
systemctl --user try-restart dwl-bar.service dwl-wallpaper.service

#!/bin/sh
set -eu
config=${DWL_CONFIG_DIR:-$HOME/.config/dwl}
runtime=${DWL_RUNTIME_DIR:-$XDG_RUNTIME_DIR/dwl}
mode=${DWL_THEME:-$(darkman get 2>/dev/null || printf dark)}
case "$mode" in light) ;; *) mode=dark ;; esac
if [ "${1:-}" = -e ]; then shift; fi
case ${1:-} in
    ''|-*) ;;
    *) set -- --title="$(basename "$1")" "$@" ;;
esac
[ -f "$runtime/foot-$mode.conf" ] || "$config/scripts/dwl-render-theme" "$mode"
font=$(sed -n 's/^font=//p' "$config/foot/foot.ini")
while IFS= read -r override; do
    set -- "--override=$override" "$@"
done <<EOF
$("$config/scripts/dwl-foot-colors" --overrides)
EOF
set -- "--override=initial-color-theme=$mode" "$@"
if [ -S "$runtime/foot.sock" ]; then
    exec footclient --client-environment --server-socket="$runtime/foot.sock" --override="font=$font" "$@"
fi
exec foot --config="$runtime/foot.conf" --override="font=$font" "$@"

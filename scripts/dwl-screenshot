#!/bin/sh
set -eu
output_dir=$HOME/pictures/Screenshots
mkdir -p "$output_dir"
output=$output_dir/screenshot-$(date '+%Y%m%d-%H%M%S-%N').png
case ${1:-} in
    full) grim "$output" ;;
    region)
        geometry=$(slurp) || exit 0
        [ -n "$geometry" ] || exit 0
        grim -g "$geometry" "$output"
        ;;
    *) printf 'usage: %s full|region\n' "$0" >&2; exit 2 ;;
esac
wl-copy --type image/png <"$output"

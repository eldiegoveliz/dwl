#!/bin/sh
set -eu

mode=${1:-}
screenshot_dir=/home/diego/pictures/screenshots
screenshot_file=$screenshot_dir/$(date '+%Y-%m-%d-%H:%M:%S.png')

mkdir -p "$screenshot_dir"

case $mode in
	full)
		grim "$screenshot_file"
		;;
	region)
		geometry=$(slurp)
		grim -g "$geometry" "$screenshot_file"
		;;
	*)
		printf 'usage: %s full|region\n' "$0" >&2
		exit 2
		;;
esac

wl-copy --type image/png <"$screenshot_file"

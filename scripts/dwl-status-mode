#!/bin/sh
set -eu
case ${1:-} in
    full|mini)
        printf '%s\n' "$1" > "$XDG_RUNTIME_DIR/dwl/bar-mode"
        exec systemctl --user restart dwl-bar.service ;;
    toggle)
        if systemctl --user is-active --quiet dwl-bar.service; then
            exec systemctl --user stop dwl-bar.service
        else
            exec systemctl --user start dwl-bar.service
        fi ;;
    *) exit 2 ;;
esac

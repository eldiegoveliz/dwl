#!/bin/sh
set -eu

runtime_dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/dwl-session
status_fifo=${DWL_STATUS_FIFO:-$runtime_dir/status}
status_pid_file=${DWL_STATUS_PID_FILE:-$runtime_dir/status.pid}
mode=${1:-}

case $mode in
	full) status_command=/usr/local/bin/slstatus ;;
	mini) status_command=/usr/local/bin/slstatus-mini ;;
	*)
		printf 'usage: %s full|mini\n' "$0" >&2
		exit 2
		;;
esac

if [ ! -p "$status_fifo" ]; then
	printf 'dwl status FIFO is unavailable: %s\n' "$status_fifo" >&2
	exit 1
fi

if [ -r "$status_pid_file" ]; then
	old_pid=$(sed -n '1p' "$status_pid_file")
	case $old_pid in
		*[!0-9]*|'') ;;
		*)
			if [ -r "/proc/$old_pid/comm" ]; then
				old_name=$(sed -n '1p' "/proc/$old_pid/comm")
				case $old_name in
					slstatus|slstatus-mini)
						kill "$old_pid" 2>/dev/null || true
						for _attempt in 1 2 3 4 5; do
							kill -0 "$old_pid" 2>/dev/null || break
							sleep 0.05
						done
						if kill -0 "$old_pid" 2>/dev/null; then
							printf 'Previous status process did not stop: %s\n' "$old_pid" >&2
							exit 1
						fi
						;;
				esac
			fi
			;;
	esac
fi

"$status_command" -s >"$status_fifo" 2>"$runtime_dir/status.log" &
printf '%s\n' "$!" >"$status_pid_file"

#!/bin/sh
set -eu
export DWL_CONFIG_DIR=${DWL_CONFIG_DIR:-$HOME/.config/dwl}
export PATH="$DWL_CONFIG_DIR/scripts:$HOME/.local/bin:$PATH"
export XDG_CURRENT_DESKTOP=dwl XDG_SESSION_DESKTOP=dwl XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland GDK_BACKEND=wayland MOZ_ENABLE_WAYLAND=1
export DWL_INFO="$XDG_RUNTIME_DIR/dwl/status"
unset DISPLAY XAUTHORITY
mkdir -p "$XDG_RUNTIME_DIR/dwl"
: > "$DWL_INFO"
cleanup() {
    systemctl --user stop dwl-bar.service dwl-notifications.service dwl-wallpaper.service \
        dwl-terminal.service dwl-monitors.service
    systemctl --user unset-environment WAYLAND_DISPLAY DWL_INFO DWL_CONFIG_DIR
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
/usr/bin/dwl -s 'exec "$DWL_CONFIG_DIR/scripts/dwl-autostart"' </dev/null

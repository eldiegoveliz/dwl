#!/bin/sh
set -eu

repo_dir=/home/diego/.config/suckless/dwl
runtime_dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/dwl-session
status_fifo=$runtime_dir/status
status_pid_file=$runtime_dir/status.pid

export XDG_CURRENT_DESKTOP=dwl
export XDG_SESSION_DESKTOP=dwl
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland
export MOZ_ENABLE_WAYLAND=1
export DWL_STATUS_FIFO=$status_fifo
export DWL_STATUS_PID_FILE=$status_pid_file

cleanup()
{
	if [ -r "$status_pid_file" ]; then
		status_pid=$(sed -n '1p' "$status_pid_file")
		case $status_pid in
			*[!0-9]*|'') ;;
			*)
				if [ -r "/proc/$status_pid/comm" ]; then
					status_name=$(sed -n '1p' "/proc/$status_pid/comm")
					case $status_name in
						slstatus|slstatus-mini) kill "$status_pid" 2>/dev/null || true ;;
					esac
				fi
				;;
		esac
	fi
	rm -f "$status_pid_file" "$status_fifo"
	rmdir "$runtime_dir" 2>/dev/null || true
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$runtime_dir"
chmod 700 "$runtime_dir"
rm -f "$status_pid_file" "$status_fifo"
mkfifo -m 600 "$status_fifo"

# Keep one writer open so changing status producers never hangs up dwl's stdin.
exec 3<>"$status_fifo"
"$repo_dir/scripts/dwl-status-mode" full

set +e
/usr/bin/dwl -s "$repo_dir/scripts/dwl-autostart" <"$status_fifo"
dwl_status=$?
set -e

exit "$dwl_status"

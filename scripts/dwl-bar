#!/bin/sh
set -eu
config=${DWL_CONFIG_DIR:-$HOME/.config/dwl}
runtime=${DWL_RUNTIME_DIR:-$XDG_RUNTIME_DIR/dwl}
mode=${DWL_THEME:-$(darkman get 2>/dev/null || printf dark)}
case "$mode" in
    light) . "$config/theme/light.conf" ;;
    *) mode=dark; . "$config/waybar/palette.conf" ;;
esac
. "$("$config/scripts/dwl-palette" "$mode")"
export background foreground muted accent urgent bar_alpha
export DWL_INFO=${DWL_INFO:-$runtime/status}
mkdir -p "$runtime"
envsubst '${background} ${foreground} ${muted} ${accent} ${urgent} ${bar_alpha}' \
    < "$config/waybar/style.css" > "$runtime/waybar.css"
bar_mode=$(cat "$runtime/bar-mode" 2>/dev/null || printf mini)
pids=
cleanup() { [ -z "$pids" ] || kill $pids 2>/dev/null || true; }
trap cleanup EXIT
trap 'exit 0' INT TERM
outputs=
while :; do
    for pid in $pids; do
        if ! kill -0 "$pid" 2>/dev/null; then outputs=; break; fi
    done
    current=$(wlr-randr --json | jq -r '.[] | select(.enabled) | .name')
    if [ "$current" != "$outputs" ]; then
        cleanup
        pids=
        outputs=$current
        for monitor in $outputs; do
            width=$(wlr-randr --json | jq -r --arg monitor "$monitor" '.[] | select(.name == $monitor) | (.scale // 1) as $scale | .modes[] | select(.current) | (.width / $scale | floor)')
            "$config/scripts/dwl-bar-render" "$monitor" "${width:-1366}" "$bar_mode"
            waybar --config="$runtime/waybar-$monitor.json" --style="$runtime/waybar.css" &
            pids="$pids $!"
        done
    fi
    sleep 2
done

#!/bin/sh
set -eu
config=${DWL_CONFIG_DIR:-$HOME/.config/dwl}
runtime=${DWL_RUNTIME_DIR:-$XDG_RUNTIME_DIR/dwl}
mode=${DWL_THEME:-$(darkman get 2>/dev/null || printf dark)}
case "$mode" in light) ;; *) mode=dark ;; esac
[ -f "$runtime/foot.conf" ] || "$config/scripts/dwl-render-theme" "$mode"
exec foot --config="$runtime/foot.conf" --override="initial-color-theme=$mode" \
    --server="$runtime/foot.sock"

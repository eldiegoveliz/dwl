#!/bin/sh
set -eu

outputs=$(wlr-randr --json)
internal=$(printf '%s\n' "$outputs" | jq -r '.[] | select(.name | startswith("eDP-")) | .name' | sed -n '1p')

if [ -z "$internal" ]; then
	printf 'No internal eDP output was found.\n' >&2
	exit 1
fi

internal_enabled=$(printf '%s\n' "$outputs" | jq -r --arg name "$internal" '.[] | select(.name == $name) | .enabled')
enabled_count=$(printf '%s\n' "$outputs" | jq '[.[] | select(.enabled == true)] | length')
external=$(printf '%s\n' "$outputs" | jq -r '.[] | select(.enabled == true and (.name | startswith("HDMI-A-"))) | .name' | sed -n '1p')

if [ "$internal_enabled" = true ]; then
	if [ "$enabled_count" -le 1 ]; then
		printf 'Refusing to disable the only enabled output: %s\n' "$internal" >&2
		notify-send 'Display unchanged' "$internal is the only enabled output." 2>/dev/null || true
		exit 1
	fi
	wlr-randr --output "$internal" --off
else
	if [ -n "$external" ]; then
		wlr-randr \
			--output "$internal" --on --pos 0,0 \
			--output "$external" --right-of "$internal"
	else
		wlr-randr --output "$internal" --on --pos 0,0
	fi
fi
